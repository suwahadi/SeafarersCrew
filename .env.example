# Copy to .env and fill in. Never commit .env.
# Only bootstrap and infrastructure values live here; everything else is in the admin Settings panel.

APP_ENV=local
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
API_URL=http://localhost:8080
# Optional internal origin of the Next.js site that the API calls to revalidate pages; defaults to APP_URL
WEB_URL=

# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

POSTGRES_USER=seafarers
POSTGRES_PASSWORD=
POSTGRES_DB=seafarers
DATABASE_URL=postgres://seafarers:CHANGE_ME@postgres:5432/seafarers?sslmode=disable

REDIS_URL=redis://redis:6379/0
GOTENBERG_URL=http://gotenberg:3000

# Optional: copied into Settings > Object Storage on first boot only; the bucket is created if missing.
S3_BOOTSTRAP_ENDPOINT=http://s3:8333
S3_BOOTSTRAP_BUCKET=seafarers
S3_BOOTSTRAP_REGION=us-east-1
S3_BOOTSTRAP_ACCESS_KEY_ID=
S3_BOOTSTRAP_SECRET_ACCESS_KEY=
S3_BOOTSTRAP_USE_PATH_STYLE=true

# Bundled S3-compatible store, SeaweedFS (docker compose --profile s3 up -d).
# Use the same values for S3_BOOTSTRAP_ACCESS_KEY_ID and S3_BOOTSTRAP_SECRET_ACCESS_KEY.
LOCAL_S3_ACCESS_KEY=
LOCAL_S3_SECRET_KEY=

# Public domain served by Caddy, e.g. seafarerscrew.com (admin.<domain> and api.<domain> are derived)
DOMAIN=localhost

LOG_LEVEL=info

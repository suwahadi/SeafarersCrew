# Copy to .env and fill in. Never commit .env.
# Only bootstrap and infrastructure values live here; everything else is in the admin Settings panel.

APP_ENV=local
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
API_URL=http://localhost:8080

# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

POSTGRES_USER=seafarers
POSTGRES_PASSWORD=
POSTGRES_DB=seafarers
DATABASE_URL=postgres://seafarers:CHANGE_ME@postgres:5432/seafarers?sslmode=disable

REDIS_URL=redis://redis:6379/0
GOTENBERG_URL=http://gotenberg:3000

# Optional: copied into Settings > Object Storage on first boot only.
S3_BOOTSTRAP_ENDPOINT=http://minio:9000
S3_BOOTSTRAP_BUCKET=seafarers
S3_BOOTSTRAP_REGION=us-east-1
S3_BOOTSTRAP_ACCESS_KEY_ID=
S3_BOOTSTRAP_SECRET_ACCESS_KEY=
S3_BOOTSTRAP_USE_PATH_STYLE=true

# Bundled MinIO (docker compose --profile minio up -d)
MINIO_ROOT_USER=seafarers
MINIO_ROOT_PASSWORD=

# Public domain served by Caddy, e.g. seafarerscrew.com (admin.<domain> and api.<domain> are derived)
DOMAIN=localhost

LOG_LEVEL=info
